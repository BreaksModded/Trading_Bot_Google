# ============================================================
# Bot de Trading Algorítmico — Variables de Entorno
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a Git.
# ============================================================

# --- Bybit API ---
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=true

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Dashboard Authentication ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_password
JWT_SECRET_KEY=change_this_to_a_random_string_at_least_32_chars

# --- Healthchecks.io ---
HEALTHCHECK_PING_URL=https://hc-ping.com/your-uuid-here

# --- Database ---
DATABASE_PATH=data/trading_bot.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log

# --- Server (Production) ---
# Use 0.0.0.0 to allow external access, 127.0.0.1 for local only
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
