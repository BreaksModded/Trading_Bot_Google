# ============================================================
# Bot de Futuros (OKX X-Perps · ETHUSDT) — Variables de Entorno
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a Git.
# IMPORTANTE: los comentarios van en su PROPIA línea. Un comentario
# al final de una línea "KEY=valor" rompe el parseo de python-dotenv.
# ============================================================

# --- OKX API (X-Perps · cuenta unificada) ---
# DEMO primero: crea las claves en "Trading Demo" de OKX y deja OKX_DEMO=true.
# Real: claves de la cuenta real (permiso Leer + Operar, SIN Retirar) y OKX_DEMO=false.
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_API_PASSPHRASE=your_okx_api_passphrase
OKX_DEMO=true

# --- Estrategia de futuros ---
FUTURES_SYMBOL=ETHUSDT
FUTURES_LEVERAGE=5
FUTURES_RISK_PER_TRADE_PCT=0.015
FUTURES_MAX_DAILY_LOSS_PCT=0.06
FUTURES_MAX_TOTAL_DRAWDOWN_PCT=0.20
FUTURES_TIMEFRAME=60
FUTURES_HIGHER_TIMEFRAME=240

# --- Telegram (alertas de trades / kill-switch) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_ENABLED=true

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_password
JWT_SECRET_KEY=change_this_to_a_random_string_at_least_32_chars

# --- Base de datos y logs ---
DATABASE_PATH=data/futures_bot.db
LOG_LEVEL=INFO
LOG_FILE=logs/futures_bot.log

# --- Healthcheck (opcional) ---
HEALTHCHECK_PING_URL=
